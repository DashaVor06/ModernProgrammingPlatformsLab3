PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bus_aggregator
JWT_ACCESS_SECRET=intercity_bus_aggregator_secret_access_key_bsuir_2026
JWT_REFRESH_SECRET=intercity_bus_aggregator_secret_refresh_key_bsuir_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# Публичный адрес фронтенда (для ссылок в письмах)
APP_URL=http://localhost:3000

# --- Почта: реальная отправка писем ---
# Используется Gmail SMTP: письма уходят с вашего Gmail на ЛЮБОЙ адрес получателя.
# Чтобы вернуться на Resend — задайте RESEND_API_KEY (он имеет приоритет над SMTP).
RESEND_API_KEY=

# Gmail SMTP (пароль приложения, создаётся при включённой 2FA)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dashasolnyshko.ds@gmail.com
SMTP_PASS=htwwrvdqztdgeens

# Адрес отправителя (должен совпадать с SMTP_USER для Gmail)
MAIL_FROM="Межгород Экспресс <dashasolnyshko.ds@gmail.com>"
