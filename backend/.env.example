PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bus_aggregator
JWT_ACCESS_SECRET=intercity_bus_aggregator_secret_access_key_bsuir_2026
JWT_REFRESH_SECRET=intercity_bus_aggregator_secret_refresh_key_bsuir_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*

# Публичный адрес фронтенда (для ссылок в письмах)
APP_URL=http://localhost:3000

# --- Почта: реальная отправка писем ---
# Вариант 1 (рекомендуется): Resend. Ключ: https://resend.com/api-keys
# Без своего домена Resend отправляет с onboarding@resend.dev только на адрес,
# которым вы зарегистрировались. Для любых получателей — подтвердите домен.
RESEND_API_KEY=

# Вариант 2: обычный SMTP (Gmail/Yandex/Mail.ru)
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=587 SMTP_SECURE=false  SMTP_PASS=<app-password>
# Yandex: SMTP_HOST=smtp.yandex.ru  SMTP_PORT=465 SMTP_SECURE=true
# Mail.ru: SMTP_HOST=smtp.mail.ru   SMTP_PORT=465 SMTP_SECURE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Адрес отправителя. Для Resend без домена: "Межгород Экспресс <onboarding@resend.dev>"
# Если не задан — подставится автоматически.
# MAIL_FROM="Межгород Экспресс <onboarding@resend.dev>"
